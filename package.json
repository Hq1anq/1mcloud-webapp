{
  "name": "1mcloud_requests",
  "version": "1.0.0",
  "description": "1mcloud manager, proxy checker",
  "main": "./src/server/server.js",
  "type": "module",
  "scripts": {
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "debug": "node --inspect ./src/server.js",
    "start": "node ./src/server.js",
    "sync-mmdb": "npm run sync-mmdb --prefix server"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hq1anq/1mcloud_tools.git"
  },
  "author": "Trinh Hoang Giang",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Hq1anq/1mcloud_tools/issues"
  },
  "homepage": "https://github.com/Hq1anq/1mcloud_tools#readme",
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}