{
  "name": "1mcloud_server",
  "version": "1.0.0",
  "description": "1mcloud manager, proxy checker",
  "homepage": "https://github.com/Hq1anq/1mcloud_tools#readme",
  "bugs": {
    "url": "https://github.com/Hq1anq/1mcloud_tools/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hq1anq/1mcloud_tools.git"
  },
  "license": "ISC",
  "author": "Trinh Hoang Giang",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --env-file=.env --import tsx/esm --watch src/server.js",
    "start": "node --env-file=.env --import tsx/esm src/server.js",
    "sync-mmdb": "node scripts/syncMmdb.js",
    "sync-prices": "node --env-file=.env scripts/sync-prices.js",
    "update-proxies": "node --env-file=.env scripts/updateProxyList.js",
    "clean-refunded": "node --env-file=.env scripts/cleanRefundedRows.js"
  },
  "dependencies": {
    "@maxmind/geoip2-node": "^6.3.4",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "mssql": "^12.2.0",
    "socks-proxy-agent": "^8.0.5",
    "tsx": "^4.23.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0"
  }
}